      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Accuracy By Hour",
        "description": "Get forecast error profiling grouped by hour of the day (0 to 23 UTC).",
        "operationId": "get_accuracy_by_hour_api_accuracy_by_hour_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
