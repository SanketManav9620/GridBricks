        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DailyAccuracyItem"
                  },
                  "title": "Response Get Accuracy Daily Api Accuracy Daily Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
