{
  "openapi": "3.1.0",
  "info": {
    "title": "UK Day-Ahead Wind Trading & Analytics API",
    "description": "Production-grade API providing point-in-time wind forecasts, actuals, accuracy analytics, and dynamic safety buffer sizing for the UK wholesale electricity market.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Health",
        "description": "Health check endpoint returning system status and current UTC timestamp.",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Get Metadata",
        "description": "Return available delivery dates, default cutoff gate, and dataset statistics.",
        "operationId": "get_metadata_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/forecast": {
      "get": {
        "tags": [
          "Trading Desk"
        ],
        "summary": "Get Forecast",
        "description": "Get the latest wind forecast available at decision cutoff for all 48 half-hour settlement periods,\nincluding historical revisions and conservative risk hedge bands (P90 and P95).",
        "operationId": "get_forecast_api_forecast_get",
        "parameters": [
          {
            "name": "delivery_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Delivery date (YYYY-MM-DD)",
              "title": "Delivery Date"
            },
            "description": "Delivery date (YYYY-MM-DD)"
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
              "default": "11:00",
              "title": "Cutoff"
            },
            "description": "Cutoff time on D-1 in HH:MM (London time)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/actuals": {
      "get": {
        "tags": [
          "Trading Desk"
        ],
        "summary": "Get Actuals",
        "description": "Get actual outturn generation for all 48 half-hour settlement periods on delivery_date.",
        "operationId": "get_actuals_api_actuals_get",
        "parameters": [
          {
            "name": "delivery_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Delivery date (YYYY-MM-DD)",
              "title": "Delivery Date"
            },
            "description": "Delivery date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActualsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accuracy/summary": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Accuracy Summary",
        "description": "Get holistic accuracy metrics across all January 2026 trading days:\nBias (MBE), MAE, RMSE, WAPE, Percentiles, and empirical Safety Buffers.",
        "operationId": "get_accuracy_summary_api_accuracy_summary_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
              "default": "11:00",
              "title": "Cutoff"
            },
            "description": "Cutoff time on D-1 in HH:MM (London time)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracySummaryResponse"
