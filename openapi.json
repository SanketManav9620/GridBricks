    },
    "/api/accuracy/by-horizon": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Accuracy By Horizon",
        "description": "Get forecast accuracy breakdown by lead-time horizon buckets (0-6h, 6-12h, 12-24h, 24-48h, 48h+).",
        "operationId": "get_accuracy_by_horizon_api_accuracy_by_horizon_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
              "default": "11:00",
              "title": "Cutoff"
