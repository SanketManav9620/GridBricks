      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Accuracy Daily",
        "description": "Get day-by-day accuracy metrics and expanding-window dynamic recommended safety buffer.",
        "operationId": "get_accuracy_daily_api_accuracy_daily_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
              "default": "11:00",
              "title": "Cutoff"
            },
            "description": "Cutoff time on D-1 in HH:MM (London time)"
