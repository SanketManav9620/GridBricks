    "/api/accuracy/distribution": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Accuracy Distribution",
        "description": "Get error frequency distribution histogram (Forecast - Actual) for risk profiling.",
        "operationId": "get_accuracy_distribution_api_accuracy_distribution_get",
        "parameters": [
          {
            "name": "bin_size_mw",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2000.0,
              "minimum": 100.0,
              "description": "Bin width in MW",
              "default": 500.0,
              "title": "Bin Size Mw"
            },
            "description": "Bin width in MW"
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Cutoff time on D-1 in HH:MM (London time)",
              "default": "11:00",
              "title": "Cutoff"
            },
            "description": "Cutoff time on D-1 in HH:MM (London time)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ErrorHistogramItem"
                  },
                  "title": "Response Get Accuracy Distribution Api Accuracy Distribution Get"
